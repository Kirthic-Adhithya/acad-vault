# ──────────────────────────────────────────────────────────
# Academic Vault — environment variable template
# Copy this file to .env and fill in the values.
# NEVER commit a real .env file — it is in .gitignore.
# ──────────────────────────────────────────────────────────

# ── Database ───────────────────────────────────────────────
# Local dev: leave as-is (SQLite file will be created automatically)
DATABASE_URL=sqlite:///./academic_vault.db

# Production (RDS): uncomment and fill in after Member 1 provides the endpoint
# DATABASE_URL=mysql+pymysql://admin:YOUR_PASSWORD@YOUR_RDS_ENDPOINT:3306/academic_vault

# ── S3 ─────────────────────────────────────────────────────
# Member 1 will provide the bucket name.
S3_BUCKET_NAME=your-bucket-name-here
AWS_REGION=ap-south-1

# ── AWS credentials (local dev ONLY) ───────────────────────
# On EC2 these are NOT needed — the IAM role attached to the instance
# is picked up automatically by boto3 (credential chain).
# For local dev: use a personal IAM access key (never commit these).
# AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# ── Optional ────────────────────────────────────────────────
# How long presigned download URLs stay valid (default: 3600 = 1 hour)
# PRESIGNED_URL_EXPIRY=3600
